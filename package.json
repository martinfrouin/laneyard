{
  "name": "laneyard",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "laneyard": "dist/src/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/src/db/ && npm run build:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fastify/cookie": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@lezer/highlight": "^1.2.3",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "node-pty": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tinyglobby": "^0.2.10",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "description": "A self-hosted web UI for fastlane: trigger lanes from your browser, watch builds stream live, keep your artifacts and your signing keys.",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinfrouin/laneyard.git"
  },
  "files": [
    "dist/src",
    "dist/web",
    "ruby",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fastlane",
    "ci",
    "self-hosted",
    "ios",
    "android",
    "mobile",
    "build-server",
    "testflight"
  ]
}
